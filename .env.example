# Copiez ce fichier en .env.local pour le développement local,
# ou renseignez ces variables dans le tableau de bord de votre hébergeur.

# ── Base de données ──────────────────────────────────────────────────────────
# En ligne (Vercel, Render…) : base Turso persistante.
# Laissez ces deux variables vides pour utiliser le fichier SQLite local.
# TURSO_DATABASE_URL=libsql://fromagerie-caprine-<organisation>.turso.io
# TURSO_AUTH_TOKEN=eyJhbGciOi...

# En local uniquement : dossier / chemin de la base SQLite
# FROMAGERIE_DATA_DIR=./data
# FROMAGERIE_DB=./data/fromagerie.db

# ── Données de démonstration ─────────────────────────────────────────────────
# 1 (défaut) = génère deux mois de données au premier lancement (base vide).
# 0 = base vide : à utiliser en production pour ne pas créer de fausses journées.
# DEMO_DATA=0

# ── Sécurité ─────────────────────────────────────────────────────────────────
# Mot de passe partagé demandé à l'ouverture de l'application.
# Sans cette variable, l'application est accessible sans mot de passe.
# APP_PASSWORD=choisissez-un-mot-de-passe-solide

# Clé de signature des cookies (optionnelle mais recommandée).
# Générez-la avec : openssl rand -hex 32
# AUTH_SECRET=

# ── Divers ───────────────────────────────────────────────────────────────────
# Port du serveur (Render l'injecte automatiquement)
# PORT=3000

# Fuseau horaire utilisé pour la date du jour
# APP_TIMEZONE=Europe/Paris
